{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "types": ["node"],
    "lib": ["es2022", "dom"],
    "paths": {
      "@/*": ["../app/src/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
